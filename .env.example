# Pawabase local Docker development
# Copy this file to .env. The first five values are the only values required
# for `docker compose -f docker-compose.dev.yml up -d`.

# Generate each secret with: openssl rand -hex 32
PAWABASE_INTERNAL_SECRET=
PAWABASE_JWT_MASTER_SECRET=
PAWABASE_MASTER_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=

# ── Local appearance and access (optional) ──────────────────────────────────
# PAWABASE_PROJECT_NAME=Pawabase
# PAWABASE_PUBLIC_URL=http://localhost:8080
# PAWABASE_PUBLIC_GATEWAY_URL=http://localhost:8080
# PAWABASE_COOKIE_SECURE=false
# PAWABASE_STUDIO_USERNAME=operator
# PAWABASE_STUDIO_PASSWORD=use-a-long-unique-password

# ── Performance profile (optional) ──────────────────────────────────────────
# Docker development uses uvloop and httptools by default. Pawabase keeps one
# API process because its public and internal listeners share live runtime
# state. Scale queue workers instead: the dev default is 4 worker containers,
# each accepting 4 concurrent jobs.
# PAWABASE_HTTP_LOOP=uvloop
# PAWABASE_HTTP_PROTOCOL=httptools
# PAWABASE_HTTP_BACKLOG=2048
# PAWABASE_HTTP_KEEP_ALIVE=10
# PAWABASE_HTTP_LIMIT_CONCURRENCY=0
# PAWABASE_WORKER_REPLICAS=4
# PAWABASE_WORKER_CONCURRENCY=4

# ── External storage (only instead of bundled MinIO) ─────────────────────────
# PAWABASE_STORAGE_ENDPOINT=https://storage.example.com
# PAWABASE_STORAGE_PUBLIC_ENDPOINT=https://files.example.com
# PAWABASE_STORAGE_BUCKET=pawabase
# PAWABASE_STORAGE_REGION=auto
# PAWABASE_STORAGE_ACCESS_KEY=
# PAWABASE_STORAGE_SECRET_KEY=
# PAWABASE_STORAGE_PATH_STYLE=true

# ── Cloud-managed runtime (only when this Docker runtime is a Cloud pool) ────
# Do not set these for a normal self-hosted/local Pawabase installation.
# PAWABASE_AGENT_POOL=
# PAWABASE_AGENT_TOKEN=
# PAWABASE_AGENT_SECRET_SEED=
# PAWABASE_AGENT_DATABASES=
