# Copy to .env and fill in. Generate each secret with:  openssl rand -hex 32

# Signs service-to-service tokens and the gateway's platform context.
PAWABASE_INTERNAL_SECRET=
# Master secret per-environment user token secrets are derived from.
PAWABASE_JWT_MASTER_SECRET=
# Encrypts environment secrets and webhook signing keys at rest.
PAWABASE_MASTER_KEY=

POSTGRES_PASSWORD=

# File storage runs on the bundled MinIO by default. Compose builds its final
# community source release; these are its root credentials and Pawabase uses
# them for storage too. Use 8+ characters.
MINIO_ROOT_PASSWORD=
# MINIO_ROOT_USER=pawabase

# What this backend calls itself: Studio's title and the title of its API docs.
# PAWABASE_PROJECT_NAME=Pawabase

# Studio is local-only by default. To protect a self-hosted Studio with its own
# login form, set both values below. This is independent of Pawabase Cloud.
# PAWABASE_STUDIO_USERNAME=operator
# PAWABASE_STUDIO_PASSWORD=use-a-long-unique-password

# Where clients and browsers reach the gateway: links in emails, OAuth
# callbacks and signed storage URLs are built from it.
PAWABASE_PUBLIC_URL=http://localhost:8080
PAWABASE_PUBLIC_GATEWAY_URL=http://localhost:8080
# Studio's session cookie is Secure when this is true: set it behind HTTPS.
PAWABASE_COOKIE_SECURE=false

# Optional installation limits. 0 disables each limit. Gateway request quotas
# are leased in blocks, so Redis is not contacted for every request.
# PAWABASE_DAILY_REQUEST_LIMIT=0
# PAWABASE_MONTHLY_REQUEST_LIMIT=0
# PAWABASE_REQUEST_QUOTA_RESERVATION=64
# PAWABASE_MAX_ACTIVE_CONNECTIONS=0
# PAWABASE_MAX_UPLOAD_BYTES=52428800
# PAWABASE_MAX_USERS=0
# PAWABASE_MAX_ENVIRONMENTS=0
# PAWABASE_MAX_API_KEYS_PER_ENVIRONMENT=0

# Optional
# PAWABASE_GATEWAY_PORT=8080
# PAWABASE_STUDIO_PORT=8090
# Resource data when no database is configured for an environment in Studio
# (Settings → Infrastructure). Docker defaults this to its Postgres database;
# resource tables are isolated per project/environment.
# PAWABASE_DEFAULT_DATA_URL=postgres://pawabase:<password>@postgres:5432/pawabase

# File storage on your own S3-compatible service instead of the bundled MinIO
# (AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, Wasabi, Ceph, ...).
# Set these and run `docker compose up -d --scale minio=0`. Pawabase creates the
# bucket if it does not exist and keeps every project's files under its own
# prefix, so one bucket serves the whole installation.
# PAWABASE_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# PAWABASE_STORAGE_BUCKET=pawabase
# PAWABASE_STORAGE_REGION=auto
# PAWABASE_STORAGE_ACCESS_KEY=
# PAWABASE_STORAGE_SECRET_KEY=
# Virtual-hosted addressing (bucket.host) instead of /bucket paths, e.g. AWS S3:
# PAWABASE_STORAGE_PATH_STYLE=false
# Where browsers reach the service, when it differs from the endpoint above:
# PAWABASE_STORAGE_PUBLIC_ENDPOINT=
# MinIO's S3 port on this host. Browsers use it for presigned URLs; behind a
# domain, set PAWABASE_STORAGE_PUBLIC_ENDPOINT=https://files.example.com instead.
# PAWABASE_MINIO_PORT=9000
